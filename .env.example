DATABASE_URL="postgresql://rezno:change_me_in_prod@localhost:5432/rezno?schema=public"
BETTER_AUTH_SECRET="replace-with-at-least-32-random-characters"
BETTER_AUTH_URL="http://localhost:3000"
REZNO_ADMIN_EMAILS="admin@example.com,owner@example.com"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Gate 4C outbound providers fail closed by default. The deterministic sink also
# requires an exact confirmation marker and a local/test or exact staging DB.
REZNO_ENV="local"
REZNO_OUTBOUND_SINK="disabled"
REZNO_OUTBOUND_SINK_CONFIRM=""

# Gate 7D push providers remain fail-closed until a separately approved
# environment supplies every value. Generate independent values per staging or
# production environment; never commit token-encryption, signing, or provider keys.
REZNO_PUSH_ENVIRONMENT=""
REZNO_PUSH_TOKEN_ENCRYPTION_KEY=""
REZNO_PUSH_RECEIPT_PROVIDERS=""
REZNO_PUSH_RECEIPT_HMAC_SECRET=""
REZNO_APNS_TEAM_ID=""
REZNO_APNS_KEY_ID=""
REZNO_APNS_PRIVATE_KEY=""
REZNO_APNS_BUNDLE_ID=""
REZNO_APNS_ENVIRONMENT=""
REZNO_FCM_PROJECT_ID=""
REZNO_FCM_PROJECT_ENVIRONMENT=""
REZNO_FCM_CLIENT_EMAIL=""
REZNO_FCM_PRIVATE_KEY=""

# Optional for Expo mobile app development and staging.
# localhost is for simulators or a local backend only. Physical devices must use
# an HTTPS staging origin or a LAN address reachable from the device.
EXPO_PUBLIC_REZNO_API_BASE_URL="http://localhost:3000"
